      4
    ],
    "action_space": {
      "0": "HOLD",
      "1": "BUY",
      "2": "SELL",
      "3": "EXIT"
    },
    "confidence": "temperature-calibrated probability of the chosen action after masking invalid actions"
  },
  "valid_actions": {
    "flat": [
      "HOLD",
      "BUY",
      "SELL (only if allow_short)"
    ],
    "long": [
      "HOLD",
      "EXIT"
    ],
    "short": [
      "HOLD",
      "EXIT"
    ]
  },
  "execution_convention": "decision at close of bar t; fill at open of bar t+1",
